{
    "$schema": "https://opencode.ai/config.json",
    "model": "opencode/deepseek-v4-flash-free",
    // Shell tools run fish. Agents must write fish syntax (see AGENTS.md).
    "shell": "/usr/bin/fish",
    // Last match wins. Inherited base policy allows everything first; these
    // global rules are appended after it, then agent rules after these.
    "permissions": [
        // Frictionless read-only git inspection.
        { "action": "shell", "resource": "git status *", "effect": "allow" },
        { "action": "shell", "resource": "git diff *", "effect": "allow" },
        { "action": "shell", "resource": "git log *", "effect": "allow" },
        // AGENTS.md forbids staging everything. Enforce it at the tool layer.
        { "action": "shell", "resource": "git add .", "effect": "deny" },
        { "action": "shell", "resource": "git add . *", "effect": "deny" },
        { "action": "shell", "resource": "git add -A", "effect": "deny" },
        { "action": "shell", "resource": "git add -A *", "effect": "deny" },
        { "action": "shell", "resource": "git add --all *", "effect": "deny" },
        // Destructive shell shapes. Must hold under --auto.
        { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
        { "action": "shell", "resource": "sudo *", "effect": "deny" },
        { "action": "shell", "resource": "git push --force *", "effect": "deny" },
        { "action": "shell", "resource": "git push * --force *", "effect": "deny" },
        // Credential-bearing files. Never read into context or commit.
        // AGENTS.md forbids `.env`; deny it so `--auto` cannot approve it.
        { "action": "read", "resource": "*.env", "effect": "deny" },
        { "action": "read", "resource": "*.env.*", "effect": "deny" },
        { "action": "read", "resource": "*opencode/service*.json", "effect": "deny" },
        { "action": "read", "resource": "*conf.d/secrets.fish", "effect": "deny" }
    ],
    "lsp": {
        "typescript": {
            "command": [
                "typescript-language-server",
                "--stdio"
            ],
            "extensions": [
                ".ts",
                ".tsx",
                ".mts",
                ".cts",
                ".js",
                ".jsx",
                ".mjs",
                ".cjs"
            ]
        },
        "biome": {
            "command": [
                "biome",
                "lsp-proxy"
            ],
            "extensions": [
                ".ts",
                ".tsx",
                ".js",
                ".jsx",
                ".json",
                ".jsonc"
            ]
        }
    },
    "mcp": {
        "servers": {
            "browser-control": {
                "type": "local",
                "command": [
                    "browser-control-mcp"
                ],
                "disabled": true
            },
            "firecrawl": {
                "type": "remote",
                "url": "https://mcp.firecrawl.dev/v2/mcp",
                "disabled": true
            },
            "notion": {
                "type": "remote",
                "url": "https://mcp.notion.com/mcp",
                "disabled": true
            }
        }
    }
}
