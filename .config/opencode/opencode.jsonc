{
    "$schema": "https://opencode.ai/config.json",
    "model": "opencode/deepseek-v4-flash-free",
    "agents": {
        "explore": {
            "model": "opencode/muse-spark-1-3-contributor-free"
        },
        "general": {
            "model": "opencode/muse-spark-1-3-contributor-free"
        }
    },
    "lsp": {
        "typescript": {
            "command": [
                "typescript-language-server",
                "--stdio"
            ],
            "extensions": [
                ".ts",
                ".tsx",
                ".mts",
                ".cts",
                ".js",
                ".jsx",
                ".mjs",
                ".cjs"
            ]
        },
        "biome": {
            "command": [
                "biome",
                "lsp-proxy"
            ],
            "extensions": [
                ".ts",
                ".tsx",
                ".js",
                ".jsx",
                ".json",
                ".jsonc"
            ]
        }
    },
    "mcp": {
        "browser-control": {
            "type": "local",
            "command": [
                "browser-control-mcp"
            ],
            "enabled": false
        },
        "firecrawl": {
            "type": "remote",
            "url": "https://mcp.firecrawl.dev/v2/mcp",
            "enabled": false
        },
        "notion": {
            "type": "remote",
            "url": "https://mcp.notion.com/mcp",
            "enabled": false
        }
    }
}
