{
  "theme": {
    "name": "system",
    "mode": "dark"
  },
  "keybinds": {
    "session_rename": "none"
  },
  "plugins": [
    {
      "package": "@renjfk/opencode-voice",
      "options": {
        "endpoint": "http://127.0.0.1:1/v1",
        "model": "no-llm"
      }
    },
    {
      "package": "/home/samarth/repos/live-token-info/src/index.tsx",
      "options": {
        "charsPerToken": 4,
        "showTotals": true
      }
    }
  ],
  "diffs": {
    "wrap": "none"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show",
    "grouping": "none"
  },
  "animations": true,
  "debug": {
    "devtools": true,
    "turn_tokens": true
  }
}
