{
    "theme": {
        "name": "one-dark",
        "mode": "dark"
    },
    "keybinds": {
        "leader": "ctrl+o",
        "open.menu": "<leader>space",
        "session.rename": "none",
        "session_child_cycle": "right",
        "session_child_cycle_reverse": "left",
        "session.parent": "up",
        "session.child.first": "down"
    },
    "plugins": [
        {
            "package": "/home/samarth/dev/prod/live-token-meter/src/index.tsx",
            "options": {
                "charsPerToken": 4,
                "showTotals": true
            }
        }
    ],
    "diffs": {
        "wrap": "word",
        "view": "unified"
    },
    "session": {
        "sidebar": "auto",
        "scrollbar": true,
        "thinking": "hide",
        "grouping": "none"
    },
    "animations": true,
    "debug": {
        "devtools": false,
        "turn_tokens": true
    },
    "attention": {
        "enabled": true
    },
    "terminal": {
        "title": true
    },
    "tabs": {
        "layout": "horizontal"
    }
}
