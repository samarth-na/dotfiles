{
    "theme": {
        "name": "one-dark",
        "mode": "dark"
    },
    "keybinds": {
        "session_rename": "none",
        "session_child_cycle": "right",
        "session_child_cycle_reverse": "left",
        "session_parent": "up",
        "session_child_first": "down"
    },
    "plugins": [
        {
            "package": "/home/samarth/repos/live-token-info/src/index.tsx",
            "options": {
                "charsPerToken": 4,
                "showTotals": true
            }
        }
    ],
    "diffs": {
        "wrap": "word",
        "view": "unified"
    },
    "session": {
        "sidebar": "auto",
        "scrollbar": true,
        "thinking": "show",
        "grouping": "none"
    },
    "animations": true,
    "debug": {
        "devtools": true,
        "turn_tokens": true
    },
    "attention": {
        "enabled": true
    }
}
