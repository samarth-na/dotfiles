{
    "theme": {
        "name": "one-dark",
        "mode": "system"
    },
    "keybinds": {
        "leader": "ctrl+o",
        "open.menu": "<leader>space",
        "session.rename": "none",
        "session.child.next": "right",
        "session.child.previous": "left",
        "session.parent": "up",
        "session.child.first": "down"
    },
    "plugins": [
        {
            "package": "/home/samarth/dev/prod/live-token-meter",
            "options": {
                "charsPerToken": 4,
                "showTotals": true
            }
        }
    ],
    "diffs": {
        "wrap": "word",
        "view": "unified",
        "tree": true,
        "single": true
    },
    "session": {
        "sidebar": "auto",
        "scrollbar": false,
        "thinking": "hide",
        "grouping": "auto",
        "markdown": "rendered",
        "verbosity": "high",
        "image_preview": true,
        "tps": true,
        "permissions": "prompt"
    },
    "animations": true,
    "debug": {
        "devtools": false,
        "turn_tokens": true
    },
    "attention": {
        "notifications": true,
        "sound": true
    },
    "terminal": {
        "title": true,
        "copy": "select"
    },
    "tabs": {
        "layout": "horizontal",
        "mode": "on",
        "indicators": "status"
    },
    "prompt": {
      "image_preview": false
    }
}
